# Google Cloud OAuth (conta central da Deep)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://SEU-BACKEND/api/admin/google/callback

# Gere com: openssl rand -base64 32
# Nunca versione o valor real. Ele protege o refresh token Google no banco.
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Cria/atualiza a conta administradora no início do servidor.
ADMIN_USER=admin
ADMIN_PASSWORD=
ADMIN_NAME=Administração Deep

# Opcional: sincronização automática. Padrão: 5 minutos.
GOOGLE_SYNC_INTERVAL_MINUTES=5

# IDs de cor de evento aceitos para [DISPONÍVEL].
# Padrão: 7 (Pavão) e 9 (Azul/Blueberry).
GOOGLE_AVAILABLE_EVENT_COLOR_IDS=7,9

# Endereço para onde o backend redireciona após conectar a conta Google.
ADMIN_FRONTEND_URL=https://SEU-GESTOR

# Origens permitidas para o gestor e site público, separadas por vírgula.
ALLOWED_ORIGINS=https://SEU-GESTOR,https://SEU-SITE
